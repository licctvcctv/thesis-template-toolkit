<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="单词学习"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_learn_guide"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="？"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="42sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_phonetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="20sp"
                android:textColor="#757575"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_translation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="24sp"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/et_spelling_answer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:hint="输入单词拼写"
                android:inputType="textVisiblePassword|textNoSuggestions"
                android:singleLine="true"
                android:textSize="18sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_submit_spelling"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:text="提交拼写"
                android:textSize="18sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_skip_spelling"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:text="跳过本词"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_spelling_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text=""
                android:textColor="#C92A2A"
                android:textSize="16sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_show_example"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="查看 AI 例句"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_example_sentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text=""
                android:textSize="18sp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btn_read_example"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="🔊 朗读例句"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp">

        <Button
            android:id="@+id/btn_easy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="简单"
            android:backgroundTint="#4CAF50"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_hard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="困难"
            android:backgroundTint="#F44336"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_generate_essay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📖 生成今日复习短文"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btn_read_essay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="🔊 朗读短文"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">
        <TextView
            android:id="@+id/tv_essay_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击按钮，将用今日单词调用文心大模型生成一篇英文短文…"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"/>
    </ScrollView>

</LinearLayout>
