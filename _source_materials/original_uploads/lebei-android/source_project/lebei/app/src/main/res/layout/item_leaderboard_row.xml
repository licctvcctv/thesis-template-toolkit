<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tv_rank"
        android:layout_width="@dimen/leaderboard_col_rank"
        android:layout_height="wrap_content"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_username"
        android:layout_width="@dimen/leaderboard_col_username"
        android:layout_height="wrap_content"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_learned_words"
        android:layout_width="@dimen/leaderboard_col_learned"
        android:layout_height="wrap_content"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_mastered_words"
        android:layout_width="@dimen/leaderboard_col_mastered"
        android:layout_height="wrap_content"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_points"
        android:layout_width="@dimen/leaderboard_col_points"
        android:layout_height="wrap_content"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_today"
        android:layout_width="@dimen/leaderboard_col_today"
        android:layout_height="wrap_content"
        android:textSize="14sp" />
</LinearLayout>
