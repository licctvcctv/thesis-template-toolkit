# Server Configuration
PORT=3102
FUTURES_AGENT_API_TOKEN=demo-token

# DeepSeek 官方 API — https://api-docs.deepseek.com/zh-cn/
# base_url: https://api.deepseek.com  ·  端点: POST /chat/completions
# 模型: deepseek-v4-flash（常规） / deepseek-v4-pro（高推理，审计官启用 thinking）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Trading Demo
FUTURES_AGENT_TRADING_DEMO=1
FUTURES_AGENT_TRADING_LLM=1
FUTURES_AGENT_LLM_PARALLEL=0
FUTURES_AGENT_RUN_RECORD=1
