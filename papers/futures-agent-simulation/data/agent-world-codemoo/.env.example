# Server Configuration
# 服务器配置
PORT=3102
FUTURES_AGENT_API_TOKEN=demo-token

# LLM API Configuration
# 用于智能体决策的 LLM API 配置
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
FUTURES_AGENT_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Trading Demo Configuration
# 交易演示配置
FUTURES_AGENT_TRADING_DEMO=1
FUTURES_AGENT_TRADING_LLM=0
FUTURES_AGENT_LLM_MODELS=deepseek-ai/DeepSeek-V4-Flash,deepseek-ai/DeepSeek-V3.2,Qwen/Qwen3.6-35B-A3B

# Data Configuration
# 数据配置 - 现在使用本地真实历史数据，无需 API Key
# 价格来源: DataHub.io (黄金、WTI 原油、大豆历史月度价格)
