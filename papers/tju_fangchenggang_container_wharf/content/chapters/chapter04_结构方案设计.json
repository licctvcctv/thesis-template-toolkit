                  "13.50m",
                  "底标高-10.00m，顶标高+3.50m"
                ],
                [
                  "筒内回填",
                  "块石",
                  "提供稳定自重"
                ],
                [
                  "胸墙",
                  "C40现浇混凝土",
                  "连接相邻圆筒"
                ]
              ],
              "widths_in": [
