          "blocks": [
            {
              "type": "p",
              "text": "设计年通过能力取50万TEU，进口箱平均堆存期按6d计。考虑到船期集中和节假日波动，堆场峰值系数取1.20。"
            },
            {
              "type": "formula",
              "text": "平均在场箱量计算：N_y=Q_y t_s K_p/365",
              "latex": "N_y=\\frac{Q_y t_s K_p}{365}=\\frac{500000\\times6\\times1.20}{365}=9863\\ \\mathrm{TEU}",
              "number": "（3.8）"
            },
