        {
          "type": "formula",
          "text": "混凝土工程量估算：V_c=n\\sum A_i L_i",
          "latex": "V_c=10\\times780+4200=12000\\ \\mathrm{m^3}",
          "number": "（6.1）"
        },
        {
          "type": "formula",
          "text": "回填工程量估算：V_f=\\sum A_f L",
          "latex": "V_f=24000+90000=114000\\ \\mathrm{m^3}",
          "number": "（6.2）"
        },
        {
          "type": "terms",
          "intro": "式中：",
          "items": [
            [
              "V_c",
