      "CREATE TABLE IF NOT EXISTS spectra (",
      "    spectrum_id INTEGER PRIMARY KEY AUTOINCREMENT,",
      "    file_id INTEGER, scan INTEGER, retention_time DOUBLE,",
      "    precursor_mass DOUBLE, precursor_intensity DOUBLE,",
      "    precursor_charge INTEGER, num_mass INTEGER,",
      "    proteoform_id INTEGER, cluster_id INTEGER,",
      "    protein_accession VARCHAR(50), proteoform VARCHAR(1024),",
      "    e_value DOUBLE, spectrum_level_q_value DOUBLE",
      ");",
      "CREATE TABLE IF NOT EXISTS masses (",
      "    mass_id INTEGER PRIMARY KEY AUTOINCREMENT,",
      "    spectrum_id INTEGER, mass DOUBLE, intensity DOUBLE, charge INTEGER",
      ");"
